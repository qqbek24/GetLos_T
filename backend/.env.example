ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:80

# Admin mode: true  = full access (local dev / Docker)
#             false = public/portfolio mode – destructive endpoints return HTTP 403
# Leave unset on Heroku (defaults to false)
ADMIN_MODE=true

# Lotto.pl API Configuration
# Uzyskaj klucz API od Lotto.pl: kontakt@lotto.pl
# Więcej info: https://developers.lotto.pl/#section/Autoryzacja
LOTTO_API_SECRET_KEY=your_api_key_here
